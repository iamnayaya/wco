FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# ---- Dependencies ----
FROM base AS deps
COPY package.json package-lock.json ./
COPY apps/webhook-handler/package.json apps/webhook-handler/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
RUN npm ci --workspace=@wco/webhook-handler --include-workspace-root=false || npm ci

# ---- Build ----
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Prisma client generation (schema lives in the database package)
RUN npx prisma generate --schema packages/database/prisma/schema.prisma || true
RUN npm run build --workspace=@wco/webhook-handler

# ---- Runtime ----
FROM node:20-alpine AS runtime
RUN apk add --no-cache tini && addgroup -g 10001 -S wco && adduser -u 10001 -S wco -G wco
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=wco:wco /app/apps/webhook-handler/dist ./dist
COPY --from=build --chown=wco:wco /app/node_modules ./node_modules

USER wco
EXPOSE 4100

# Webhooks must survive pod restarts — SIGTERM drains in-flight requests
STOPSIGNAL SIGTERM
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
