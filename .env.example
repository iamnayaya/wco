# =============================================================================
# WCO - WhatsApp Commerce OS Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
APP_NAME=WhatsApp Commerce OS
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
MOBILE_URL=wco://

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wco_dev?schema=public
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wco_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# =============================================================================
# RABBITMQ
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=wco
JWT_AUDIENCE=wco-api

BCRYPT_ROUNDS=12

# API Keys
API_KEY_SECRET=your-api-key-secret-change-in-production
API_KEY_PREFIX=wco_

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-change-in-production
ENCRYPTION_IV=your-16-char-iv-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =============================================================================
# WHATSAPP BUSINESS API
# =============================================================================
WHATSAPP_PROVIDER=twilio
# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://your-domain.com/api/webhooks/whatsapp
# Meta Direct
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token
META_WHATSAPP_NUMBER_ID=your-whatsapp-number-id
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_WEBHOOK_URL=https://your-domain.com/api/webhooks/whatsapp

# =============================================================================
# PAYMENTS
# =============================================================================
# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/webhooks/paystack

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-flutterwave-public-key
FLUTTERWAVE_ENCRYPTION_KEY=your-flutterwave-encryption-key
FLUTTERWAVE_WEBHOOK_URL=https://your-domain.com/api/webhooks/flutterwave
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash

# OPay
OPAY_PUBLIC_KEY=your-opay-public-key
OPAY_PRIVATE_KEY=your-opay-private-key
OPAY_MERCHANT_ID=your-opay-merchant-id
OPAY_WEBHOOK_URL=https://your-domain.com/api/webhooks/opay

# =============================================================================
# LOGISTICS
# =============================================================================
# GIG Logistics
GIG_API_KEY=your-gig-api-key
GIG_API_SECRET=your-gig-api-secret
GIG_BASE_URL=https://api.giglogistics.com
GIG_WEBHOOK_URL=https://your-domain.com/api/webhooks/gig

# Kwik Delivery
KWIK_API_KEY=your-kwik-api-key
KWIK_API_SECRET=your-kwik-api-secret
KWIK_BASE_URL=https://api.kwik.delivery
KWIK_WEBHOOK_URL=https://your-domain.com/api/webhooks/kwik

# Sendy
SENDY_API_KEY=your-sendy-api-key
SENDY_API_SECRET=your-sendy-api-secret
SENDY_BASE_URL=https://api.sendy.ke
SENDY_WEBHOOK_URL=https://your-domain.com/api/webhooks/sendy

# =============================================================================
# AI ENGINE
# =============================================================================
# Anthropic Claude
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX=wco-embeddings

# AI Queue
AI_QUEUE_CONCURRENCY=10
AI_QUEUE_TIMEOUT=300000

# =============================================================================
# EMAIL
# =============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=noreply@wco.com
SMTP_FROM_NAME=WhatsApp Commerce OS

# =============================================================================
# STORAGE (AWS S3)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=wco-uploads
AWS_S3_CDN_URL=https://cdn.wco.com

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Datadog
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_SITE=datadoghq.com
DATADOG_ENV=development
DATADOG_SERVICE=wco
DATADOG_VERSION=1.0.0

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=wco
SENTRY_PROJECT=wco
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AI_AUTO_RESPONDER=true
FEATURE_AI_PRICING_OPTIMIZER=true
FEATURE_AI_SENTIMENT_ANALYSIS=true
FEATURE_AI_DEMAND_FORECASTING=true
FEATURE_MULTI_STORE=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MARKETING_AUTOMATION=true
FEATURE_ABANDONED_CART_RECOVERY=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_PRETTY_PRINT=true

# =============================================================================
# CRON JOBS
# =============================================================================
CRON_TIMEZONE=Africa/Lagos
CRON_ANALYTICS_AGGREGATION=0 2 * * *
CRON_ABANDONED_CART_CHECK=*/15 * * * *
CRON_PRICE_OPTIMIZATION=0 3 * * *
CRON_DEMAND_FORECAST=0 4 * * 0
CRON_CUSTOMER_SEGMENTATION=0 5 * * 1