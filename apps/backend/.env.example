# =============================================================================
# WCO Backend API — environment configuration (apps/backend)
# =============================================================================
# Copy to apps/backend/.env — NEVER commit real .env files.
# Root .env.example documents the full platform surface; these are the
# variables this service actually reads. All of them are validated at boot
# by src/config/env.ts — the process refuses to start on invalid config.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
LOG_FORMAT=json
# Comma-separated list; "*" disables origin checks (dev only)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wco_dev?schema=public
DATABASE_POOL_SIZE=20
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-too-min-32-characters-long-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=wco
JWT_AUDIENCE=wco-api
BCRYPT_ROUNDS=12

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# --- Background jobs ---------------------------------------------------------
WORKER_CONCURRENCY=10

# --- WhatsApp / SMS (see @wco/messaging) -------------------------------------
WHATSAPP_PROVIDER=META
META_WHATSAPP_NUMBER_ID=
META_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# --- Payments (see @wco/payments) --------------------------------------------
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Logistics (see @wco/logistics) ------------------------------------------
GIG_API_KEY=
KWIK_API_KEY=
SENDY_API_KEY=

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@wco.test
SMTP_SECURE=false

# --- Object storage -----------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=wco-uploads-dev
AWS_S3_CDN_URL=

# --- Observability -------------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true

# --- Docs & platform ops ---------------------------------------------------------
# Absolute/relative path override for the OpenAPI spec (defaults to repo docs/)
OPENAPI_SPEC_PATH=
# Platform admin API key for /api/v1/admin/* (unset = routes behave as 404)
ADMIN_API_KEY=
