// ───────────────────────────── AI ENGINE ─────────────────────────────

/// Registered LLM provider configuration. Each store can register multiple
/// models with their own API keys, rate limits, and fallback ordering.
model AIModel {
  id            String   @id @default(cuid())
  storeId       String
  provider      String   // anthropic | openai | cohere
  modelId       String   // claude-3-haiku-20240307 | gpt-4o-mini | etc.
  displayName   String
  apiKeyEnc     String?  // encrypted API key (AES-256-GCM)
  baseUrl       String?
  maxTokens     Int      @default(4096)
  temperature   Decimal  @default(0.7) @db.Decimal(3, 2)
  costPerInput  Decimal? @db.Decimal(10, 6)  // per 1K tokens
  costPerOutput Decimal? @db.Decimal(10, 6)
  rateLimitRpm  Int      @default(60)        // requests per minute
  isActive      Boolean  @default(true)
  isPrimary     Boolean  @default(false)     // primary model for the store
  priority      Int      @default(0)         // fallback ordering
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  responses  AIResponse[]
  prompts    AIPrompt[]
  feedbacks  AIFeedback[]

  @@unique([storeId, provider, modelId])
  @@index([storeId, isActive, priority])
  @@map("ai_models")
}

/// Versioned prompt templates with variable slots, A/B testing support,
/// and performance tracking (avg confidence, usage count).
model AIPrompt {
  id            String   @id @default(cuid())
  storeId       String?
  modelId       String?
  name          String   // e.g. "auto-responder-v3", "product-description"
  category      AiTemplateCategory @default(CUSTOM)
  systemPrompt  String   @db.Text
  userTemplate  String   @db.Text      // {{variable}} slots
  variables     String[] @default([])  // declared variable names
  language      String   @default("en")
  version       Int      @default(1)
  isActive      Boolean  @default(true)
  temperature   Decimal? @db.Decimal(3, 2) // override model default
  maxTokens     Int?     // override model default
  usageCount    Int      @default(0)
  avgConfidence Float    @default(0)
  totalFeedback Int      @default(0)
  avgRating     Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store    Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  model    AIModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  responses AIResponse[]

  @@unique([storeId, name, version])
  @@index([storeId, category, isActive])
  @@map("ai_prompts")
}

/// Every LLM-generated response is logged here for audit, caching,
/// and continuous-learning feedback loops.
model AIResponse {
  id            String   @id @default(cuid())
  storeId       String
  promptId      String?
  modelId       String?
  threadId      String?  // conversation context
  inputHash     String?  // SHA-256 of (systemPrompt + userPrompt) for cache lookup
  systemPrompt  String   @db.Text
  userPrompt    String   @db.Text
  output        String   @db.Text
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  latencyMs     Int      @default(0)
  confidence    Float    @default(0)
  cached        Boolean  @default(false)
  escalated     Boolean  @default(false)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  prompt   AIPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  model    AIModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  feedbacks AIFeedback[]

  @@index([storeId, createdAt])
  @@index([storeId, promptId])
  @@index([inputHash])
  @@index([threadId])
  @@map("ai_responses")
}

/// Vector embeddings for semantic search. Stores embeddings for products,
/// customers, messages, and any other entity type.
model AIEmbedding {
  id         String   @id @default(cuid())
  storeId    String
  entityType String   // product | customer | message | document
  entityId   String
  text       String   @db.Text
  embedding  Unsupported("vector(1536)")? // OpenAI text-embedding-3-small dim
  model      String   @default("text-embedding-3-small")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, entityType, entityId])
  @@index([storeId, entityType])
  @@map("ai_embeddings")
}

/// Conversation context memory. Stores the rolling context window for each
/// WhatsApp thread so the AI can reference prior turns.
model AIConversationContext {
  id            String   @id @default(cuid())
  storeId       String
  threadId      String
  window        Json     @default("[]")   // last N messages as [{role, content, ts}]
  summary       String?  @db.Text         // compressed summary of older turns
  entities      Json     @default("{}")   // accumulated entities from conversation
  intentHistory String[] @default([])     // recent intents in order
  sentiment     Sentiment @default(NEUTRAL)
  messageCount  Int      @default(0)
  expiresAt     DateTime                  // auto-cleanup TTL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, threadId])
  @@index([storeId, expiresAt])
  @@map("ai_conversation_contexts")
}

/// Seller feedback on AI responses — the continuous learning signal.
/// Feedback drives prompt optimization, confidence calibration, and
/// escalation threshold tuning.
model AIFeedback {
  id          String   @id @default(cuid())
  storeId     String
  responseId  String
  modelId     String?
  type        AIFeedbackType @default(RATING)
  rating      Int?     // 1-5 stars
  comment     String?  @db.Text
  correction  String?  @db.Text  // seller's corrected response
  tags        String[] @default([])  // helpful, wrong, too_slow, rude, etc.
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  response AIResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  model    AIModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([responseId])
  @@index([storeId, type])
  @@map("ai_feedbacks")
}

/// Tracks confidence scores and escalation decisions per use-case.
/// Sellers can tune thresholds per use-case to control the human/AI handoff.
model AIConfidenceScore {
  id          String   @id @default(cuid())
  storeId     String
  useCase     String   // auto_response | product_description | pricing | fraud | etc.
  confidence  Float
  threshold   Float    @default(0.6)
  escalated   Boolean  @default(false)
  responseId  String?
  context     Json     @default("{}")
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, useCase, createdAt])
  @@index([storeId, escalated])
  @@map("ai_confidence_scores")
}

enum AIFeedbackType {
  RATING
  CORRECTION
  THUMBS_UP
  THUMBS_DOWN
  TAG
}

enum AIUseCase {
  AUTO_RESPONSE
  PRODUCT_DESCRIPTION
  PRICING_SUGGESTION
  CUSTOMER_SEGMENT
  SALES_FORECAST
  FRAUD_DETECTION
  DELIVERY_PREDICTION
  INSIGHTS
  REPORT
  INTENT_DETECTION
  ENTITY_EXTRACTION
}
