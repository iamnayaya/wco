{
  "name": "@wco/ui",
  "version": "1.0.0",
  "description": "WCO design system — tokens + framework-agnostic React primitives",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
