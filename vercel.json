{
  "version": 2,
  "buildCommand": "npm run vercel:build:backend",
  "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund --include=dev",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}