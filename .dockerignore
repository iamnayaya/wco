# =============================================================================
# WCO Docker build context exclusions
# Speeds up builds, shrinks context, and keeps secrets/dev artifacts out of images.
# =============================================================================

# Dependencies
node_modules
**/node_modules

# Build output
dist
build
.next
out
.turbo
coverage
*.tsbuildinfo

# Environment & secrets (NEVER ship these)
.env
.env.*
!.env.example
**/.env
**/.env.*
!.env.example
*.pem
*.key
id_rsa*
*.pfx

# Version control / IDE / OS
.git
.gitignore
.github
.husky
.hg
.svn
.vscode
.idea
*.iml
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Mobile / native
apps/mobile/android
apps/mobile/ios
apps/mobile/.expo
apps/mobile/dist
*.apk
*.aab
*.ipa

# Terraform (state files contain secrets)
*.tfstate
*.tfstate.*
*.tfvars
.terraform
.terraform.lock.hcl
crash.log

# Documentation & misc
docs/
public/coverage
*.md
.render-body.json
